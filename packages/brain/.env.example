# NEAR AI Cloud (OpenAI-compatible). Key from cloud.near.ai -> API Keys.
NEAR_AI_BASE_URL=https://cloud-api.near.ai/v1
NEAR_AI_API_KEY=
# Optional overrides. Defaults are NEAR-hosted TEE models (owned_by "nearai" in /v1/models).
NEAR_AI_MODEL_SMART=deepseek-ai/DeepSeek-V4.1-Flash-1017
NEAR_AI_MODEL_CHEAP=Qwen/Qwen3.8-27B
