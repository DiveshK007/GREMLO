# NEAR: the vault (contracts-near) and the operator that registers pets, settles views and charges compute.
NEAR_NETWORK=testnet
NEAR_CONTRACT_ID=vault.gremlo.testnet
# Comma-separated, tried in order; on a 429 or timeout the next one is used. Empty = these defaults.
# Don't use rpc.testnet.near.org: it is deprecated and answers 429 to everything.
NEAR_RPC_URL=https://test.rpc.fastnear.com,https://near-testnet.drpc.org
NEAR_OPERATOR_ACCOUNT_ID=operator.gremlo.testnet
# ed25519:... private key of the operator account (from ~/.near-credentials/testnet/<account>.json). Never commit it.
NEAR_OPERATOR_PRIVATE_KEY=ed25519:replace-me
PORT=8787
# World ID v4 (IDKit relying party). The signing key never leaves the server.
WORLD_APP_ID=
RP_ID=
RP_SIGNING_KEY=
# NEAR AI Cloud for the brain (packages/brain). Key from cloud.near.ai -> API Keys.
NEAR_AI_BASE_URL=https://cloud-api.near.ai/v1
NEAR_AI_API_KEY=
# Optional overrides. Defaults are NEAR-hosted TEE models (owned_by "nearai" in /v1/models).
NEAR_AI_MODEL_SMART=deepseek-ai/DeepSeek-V4.1-Flash-1017
NEAR_AI_MODEL_CHEAP=Qwen/Qwen3.8-27B
# Fixed per-tier rate (yoctoNEAR) charged onchain to the pet's compute budget for each AI call.
# Not the real USD bill from NEAR AI. 0.0005 NEAR smart, 0.0001 NEAR cheap.
COMPUTE_FEE_SMART_YOCTO=500000000000000000000
COMPUTE_FEE_CHEAP_YOCTO=100000000000000000000
