{
  "name": "@gremlo/server",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "type": "module",
  "scripts": {
    "start": "node --env-file-if-exists=.env --import tsx src/index.ts",
    "test": "node --import tsx --test src/*.test.ts",
    "verify": "node --env-file-if-exists=.env --import tsx scripts/verify.ts",
    "verify:public": "node --import tsx scripts/verify-public.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@arkiv-network/sdk": "^1.0.1",
    "@worldcoin/idkit-core": "^4.6.0",
    "near-api-js": "7.4.0",
    "viem": "^2.57.16"
  },
  "devDependencies": {
    "@types/node": "20.16.11",
    "tsx": "^4.23.15",
    "typescript": "5.6.3"
  }
}
