# Public values only. Never put RP_SIGNING_KEY or any private key here.
NEXT_PUBLIC_SERVER_URL=http://localhost:8787
NEXT_PUBLIC_WORLD_APP_ID=app_10f1e4e2e3205d77b18030b36177779e
NEXT_PUBLIC_WORLD_RP_ID=rp_d16a352dfd881bf2
# orb | device  (orb = one real human per pet; use what the World sandbox supports)
NEXT_PUBLIC_WORLD_PRESET=orb
# NEAR: the vault the brand pays into (contracts-near). Links go to nearblocks for the network.
NEXT_PUBLIC_NEAR_NETWORK=testnet
NEXT_PUBLIC_NEAR_CONTRACT_ID=vault.notchi.testnet
# Comma-separated, tried in order on a 429 or network error. Empty = these defaults.
# Don't use rpc.testnet.near.org: it is deprecated and answers 429 to everything.
NEXT_PUBLIC_NEAR_RPC_URL=https://test.rpc.fastnear.com,https://near-testnet.drpc.org,https://testnet-rpc.intea.rs
# staging = World ID simulator (no phone/Orb). Switch to production for the real World App.
NEXT_PUBLIC_WORLD_ENV=staging
