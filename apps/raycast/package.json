{
  "$schema": "https://www.raycast.com/schemas/extension.json",
  "name": "gremlo",
  "title": "Gremlo",
  "description": "Pause the pets, start a focus session, make the pet say something, check status, answer the next ordinary approval.",
  "icon": "icon.png",
  "author": "gremlo",
  "license": "MIT",
  "commands": [
    { "name": "pause", "title": "Pause Pets", "mode": "no-view", "arguments": [{ "name": "minutes", "placeholder": "30", "type": "text", "required": false }] },
    { "name": "focus", "title": "Start Focus", "mode": "no-view", "arguments": [{ "name": "minutes", "placeholder": "25, 50 or 90", "type": "text", "required": false }] },
    { "name": "say", "title": "Say Something", "mode": "no-view", "arguments": [{ "name": "text", "placeholder": "up to 80 characters", "type": "text", "required": true }] },
    { "name": "status", "title": "Pet Status", "mode": "no-view" },
    { "name": "answer", "title": "Answer Next Approval", "mode": "no-view", "arguments": [{ "name": "answer", "placeholder": "allow or deny", "type": "text", "required": false }] }
  ],
  "dependencies": { "@raycast/api": "^1.80.0" },
  "devDependencies": { "typescript": "^5.4.0", "@types/node": "^20.0.0" },
  "scripts": { "build": "ray build -e dist", "dev": "ray develop" }
}
