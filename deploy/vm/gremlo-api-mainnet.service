# /etc/systemd/system/gremlo-api-mainnet.service  (docs/MAINNET_RUNBOOK.md)
# The mainnet API, next to the testnet one: its own pinned checkout (no auto-deploy), port, data and secrets.
[Unit]
Description=Gremlo API, NEAR mainnet
After=network-online.target
Wants=network-online.target
RequiresMountsFor=/data

[Service]
User=gremlo
Group=gremlo
WorkingDirectory=/opt/gremlo-mainnet/apps/server
EnvironmentFile=/etc/gremlo/mainnet.env
# HOLDBACK_HOURS=0 and a 1-minute worker for the first real run; raise the holdback to 24 once it is proven
Environment=NODE_ENV=production HOST=127.0.0.1 PORT=8788 REQUIRE_SIGNED=1 TRUST_PROXY=1 HOLDBACK_HOURS=0 WORKER_MINUTES=1
Environment=STORE_PATH=/data/gremlo-mainnet/data.json LOG_DIR=/data/gremlo-mainnet/logs GALLERY_DIR=/data/gremlo-mainnet/gallery
ExecStart=/usr/bin/node --import tsx src/index.ts
Restart=on-failure
RestartSec=5

NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ReadWritePaths=/data/gremlo-mainnet

[Install]
WantedBy=multi-user.target
